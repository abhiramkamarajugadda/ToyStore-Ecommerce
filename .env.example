# Copy these as environment variables (recommended) or into a local, untracked .env file.
# Local MySQL (docker-compose sets DB_URL for you)
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# DB_URL=jdbc:mysql://localhost:3306/ecomtoy

# Hosted MySQL such as Aiven (these override DB_*); Aiven needs SSL:
# SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/toystore?sslMode=REQUIRED&createDatabaseIfNotExist=true
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=your_aiven_password

# Razorpay test mode keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Seeded admin password (the demo shopper is user / user123)
ADMIN_PASSWORD=choose_a_strong_password

# Welcome email (off by default)
MAIL_ENABLED=false
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_gmail_app_password
APP_BASE_URL=http://localhost:8081
